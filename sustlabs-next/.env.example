# Local Postgres (Homebrew, already running).
# Under Docker Compose the host is the service name, not localhost:
#   DATABASE_URI=postgres://sustlabs:<POSTGRES_PASSWORD>@postgres:5432/sustlabs_cms
DATABASE_URI=postgres://user@localhost:5432/sustlabs_cms

# Docker Compose only — the password Postgres is created with. Must match the
# one embedded in DATABASE_URI above. Ignored outside Compose.
POSTGRES_PASSWORD=

# Signs admin session cookies. Generate with: openssl rand -hex 32
# Use a DIFFERENT value in every environment.
PAYLOAD_SECRET=

# Passwords for the two default admin accounts the seed creates. Leave blank to
# use the defaults committed in src/seed/users.ts — fine locally, but set these
# in production, where the committed ones are known to anyone with repo access.
# Only applied when the account is created; existing users are never touched.
SEED_PASSWORD_ASHISH=
SEED_PASSWORD_SHREYA=
NEXT_PUBLIC_SERVER_URL=
PREVIEW_SECRET=
    
# Lead forwarding — the Google Apps Script endpoint the current site posts to
LEAD_FORWARD_ENDPOINT=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GTM_ID=

# Object storage for uploads. Leave empty in local development to write to disk.
# REQUIRED in production on a serverless host, and it must be configured before
# the first production seed.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
